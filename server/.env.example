# Copy to server/.env — never commit the real key.
BASETEN_API_KEY=your-baseten-api-key
# Vision-capable Baseten Model API slug (see GET https://inference.baseten.co/v1/models)
BASETEN_MODEL=zai-org/GLM-5.3-Flash
# Retries for 429/5xx/network failures, with exponential backoff + jitter (default 2).
# BASETEN_MAX_RETRIES=2
# Optional: if set, the app must send the same value in the x-app-secret header.
# APP_SHARED_SECRET=
# PORT=8787

# Optional — natural voice output (MLH ElevenLabs promo: https://mlh.link/elevenlabs)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# Optional — GPT ears: raw-audio understanding via OpenAI transcription
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
