# Copy to server/.env — never commit the real key.
GEMINI_API_KEY=your-gemini-api-key
# Cloud Gemini/ElevenLabs features are opt-in. Keep false for local-only mode.
CLOUD_AI_ENABLED=false
# One fast multimodal Gemini model handles descriptions, conversation, and audio.
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_COMPANION_MODEL=gemini-3.8-flash
# GEMINI_VISION_MODEL=gemini-3.8-flash
# Retries for 429/5xx/network failures, with exponential backoff + jitter (default 2).
# GEMINI_MAX_RETRIES=2
# Optional: if set, the app must send the same value in the x-app-secret header.
# APP_SHARED_SECRET=
# PORT=8787

# Optional — natural voice output (MLH ElevenLabs promo: https://mlh.link/elevenlabs)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL=eleven_turbo_v2_5
