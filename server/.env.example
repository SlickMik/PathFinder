# Copy to server/.env — never commit the real key.
BASETEN_API_KEY=your-baseten-api-key
# Vision-capable Baseten Model API slug (see GET https://inference.baseten.co/v1/models)
BASETEN_MODEL=zai-org/GLM-5.3-Flash
# Optional: if set, the app must send the same value in the x-app-secret header.
# APP_SHARED_SECRET=
# PORT=8787

# Optional — OMNI Live (Huawei HTN track): one Qwen Omni call takes the user's
# raw speech + a camera frame + LiDAR context and answers with its own voice.
# Sponsored keys: https://github.com/cari-waterloo-rc/OMNI-Live-Build-the-Next-Generation-of-Real-Time-Multimodal-AI
# OMNI_API_KEY=
# OMNI_BASE_URL=https://yibuapi.com/v1
# OMNI_MODEL=qwen3.5-omni-flash
# OMNI_VOICE=Cherry

# Retries for 429/5xx/network failures, exponential backoff + jitter (default 2).
# UPSTREAM_MAX_RETRIES=2
